{
  "info": {
    "name": "Juicebox API",
    "description": "Import this collection and Juicebox.local.postman_environment.json, then select the Juicebox Local environment. Set base_url (without a trailing slash) and your test account credentials. Run Register for a new account, or Login for an existing account. Both save token and user_id in the selected environment. Create Post saves post_id for subsequent requests. Run Delete Post and Logout when finished. Registration queues a welcome email; Delete Post removes the selected post. Requests are intended for manual use; a full collection run performs these writes and requires a new registration email. All 11 application API endpoints are included, plus the home and health routes. Protected requests inherit collection bearer authentication. Authentication is limited to 5 requests/minute/IP; other API requests to 60/minute/user. Weather requires outbound provider access. Error responses may include 401, 403, 404, 422, 429 or 503; status checks assert the successful example only. No real credentials or tokens are included. All JSON responses have only data at the top level. Authentication returns data.user and data.token. Pagination returns data.items, data.links and data.meta. Errors return data.message and data.errors. HTTP 204 responses remain empty.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "register"
              ]
            },
            "description": "Creates an account and queues a welcome email. Use a unique email. Password: at least 8 characters, letters and digits, maximum 72 UTF-8 bytes. Saves token and user_id.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"password_confirmation\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const result = pm.response.json();",
                  "    pm.test('Authentication token returned', function () { pm.expect(result.data.token).to.be.a('string').and.not.empty; });",
                  "    if (result.data.token && result.data.user && result.data.user.id) {",
                  "        pm.environment.set('token', result.data.token);",
                  "        pm.environment.set('user_id', String(result.data.user.id));",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "description": "Issues a seven-day bearer token. Saves token and user_id. Use instead of Register for an existing account.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const result = pm.response.json();",
                  "    pm.test('Authentication token returned', function () { pm.expect(result.data.token).to.be.a('string').and.not.empty; });",
                  "    if (result.data.token && result.data.user && result.data.user.id) {",
                  "        pm.environment.set('token', result.data.token);",
                  "        pm.environment.set('user_id', String(result.data.user.id));",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/posts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "posts"
              ]
            },
            "description": "Creates a post belonging to the authenticated user. Saves post_id. Title maximum: 255 characters; body maximum: 10000. Do not supply user_id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hello Perth\",\n  \"body\": \"My first post from Postman.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "    const result = pm.response.json();",
                  "    if (result.data && result.data.id) pm.environment.set('post_id', String(result.data.id));",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List Posts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/posts?page={{page}}&per_page={{per_page}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "posts"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "{{page}}",
                  "description": "Positive page number (maximum 1000000)."
                },
                {
                  "key": "per_page",
                  "value": "{{per_page}}",
                  "description": "Items per page: 1\u00e2\u20ac\u201c100."
                }
              ]
            },
            "description": "Paginated posts, newest first. Response includes data.items, data.links and data.meta."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Post",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/posts/{{post_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "posts",
                "{{post_id}}"
              ]
            },
            "description": "Read the post selected by post_id, including its author. Run Create Post first or set post_id manually."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Update Post",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/posts/{{post_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "posts",
                "{{post_id}}"
              ]
            },
            "description": "Only the author may update the post. Either title or body may be omitted; at least one is required. Ownership cannot be changed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated from Postman\",\n  \"body\": \"Updated post content.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/posts/{{post_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "posts",
                "{{post_id}}"
              ]
            },
            "description": "Soft-deletes the selected post by setting deleted_at. The database record is preserved and excluded from API queries. Only the author may delete it. Successful response is empty; subsequent read, update or delete requests return 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });",
                  "if (pm.response.code === 204) pm.environment.set('post_id', '');"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
